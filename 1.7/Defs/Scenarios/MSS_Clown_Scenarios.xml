<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ScenarioDef ParentName="ScenarioBase">
		<defName>MSS_Circus</defName>
		<label>Dark Circus</label>
		<description>The Glitterworlds always needed jesters, jokers, and bards to keep the courts of the rich and bored entertained. An urbworld scientist had an idea for how to exploit this gap in the market and turn a nice profit - Sanguophage derived entertainers. They could be beaten, broken, and laughed at, but their undying and unaging nature made them perfect for a generational plaything. 
			
			The result was the Clownkin - a jolly, happy-go-lucky, court jester, but their bloodfeeding nature was not fully supressed, and without the fangs to process the Hemogen they need they have to get it through other means - HUMAN FLESH!</description>
		<scenario>
			<summary>Three victims of genetic experimentation lure unsuspecting visitors to their doom.</summary>
			<playerFaction>
				<def>PlayerFaction</def>
				<factionDef>PlayerColony</factionDef>
			</playerFaction>
			<parts>
				<li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
					<def>ConfigurePawnsXenotypes</def>
					<pawnChoiceCount>8</pawnChoiceCount>
					<customSummary>Start with three Clownkin.</customSummary>
					<overrideKinds>
						<li>
							<xenotype>MSS_Clown</xenotype>
							<pawnKind>Colonist</pawnKind>
						</li>
					</overrideKinds>
					<xenotypeCounts>
						<li>
							<xenotype>MSS_Clown</xenotype>
							<count>3</count>
							<requiredAtStart>true</requiredAtStart>
						</li>
					</xenotypeCounts>
				</li>
				<li Class="ScenPart_PlayerPawnsArriveMethod">
					<def>PlayerPawnsArriveMethod</def>
					<method>Standing</method>
				</li>
				<li Class="ScenPart_GameStartDialog">
					<def>GameStartDialog</def>
					<text>You have escaped the Urbworld testing pits and fled to the skies, but you'll need to feed on human flesh soon. If only you could use your natural entertaining skills to lure unsuspecting vistors to the greatest show in the galaxy!</text>
					<closeSound>GameStartSting</closeSound>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Silver</thingDef>
					<count>200</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>VCE_SimpleDessert</thingDef>
					<count>20</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>MedicineIndustrial</thingDef>
					<count>4</count>
				</li>
				<li Class="ScenPart_StartingAnimal">
					<def>StartingAnimal</def>
					<count>1</count>
					<bondToRandomPlayerPawnChance>0</bondToRandomPlayerPawnChance>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Teepee</thingDef>
					<stuff>Cloth</stuff>
					<count>2</count>
					<quality>Excellent</quality>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>AshlandYurt</thingDef>
					<stuff>Cloth</stuff>
					<quality>Excellent</quality>
				</li>
				<li Class="ScenPart_StartingAnimal">
					<def>StartingAnimal</def>
					<animalKind>Monkey</animalKind>
					<count>1</count>
				</li>
				<li Class="ScenPart_MonolithGeneration">
					<def>ScenPart_MonolithGeneration</def>
					<method>NearColonists</method>
				</li>
				<li Class="CustomBaseFramework.ScenPart_CBFRuinStart">
					<def>CBF_RuinStart</def>
					<plan>CBF_Plan_ModernVillage</plan>
					<ruin>CBF_Ruin_Raided</ruin>
					<sleepers>Animals</sleepers>
					<sleeperPoints>390</sleeperPoints>
					<battlefield />
					<schlaefer />
				</li>
				<!-- <li Class="ScenPart_OnPawnDeathExplode">
					<def>OnPawnDeathExplode</def>
					<radius>4</radius>
					<damage>Smoke</damage>
					<preExplosionSpawnThingDef>Filth_Confetti</preExplosionSpawnThingDef>

				</li> -->
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>FW_WheelOfFate</thingDef>
				</li>
			</parts>
		</scenario>
	</ScenarioDef>
</Defs>