    </genes>
  </XenotypeDef>
  <XenotypeDef>
    <defName>MSS_Mime</defName>
    <label>Mimekin</label>
    <description>Mimekin are the strange offshoot of the clownkin xenotype when something goes terribly wrong. All of the fun and whimsy and devouring gets inverted into pure negativity. Many believe Mimekin to be in a perpetual state of self-loathing.</description>
    <descriptionShort>An archite powered, neutral being created by a failed Clownkin conversion.</descriptionShort>
    <iconPath>UI/Icons/Xenotypes/Custom/VBE_CustomXenotypeIcon17</iconPath>
    <inheritable>true</inheritable>
    <genes>
