<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <XenotypeDef>
    <defName>MSS_Clown</defName>
    <label>Clownkin</label>
    <description>Clownkin were created by manipulating Sanguophage genelines to act as the perfect entertainers, court jesters, and bards for bored Glitterworld aristocracy. Though the experiments were successful, and the Clownkin became jolly, happy-go-lucky, fools, their bloodfeeding nature was not fully supressed, and occasionally the clownkin are believed to break into a bloody frenzy, outright devouring their targets.</description>
    <descriptionShort>A sanguophage offshoot designed to be jolly and joyous, with a dark underside.</descriptionShort>
    <iconPath>UI/Icons/Xenotypes/Custom/VBE_CustomXenotypeIcon53</iconPath>
    <inheritable>false</inheritable>
    <genes>
      <li>ArchiteMetabolism</li>
      <li>DiseaseFree</li>
      <li MayRequire="redmattis.bigsmall.core">Cannibal</li>
      <li MayRequire="redmattis.bigsmall.core">BS_FeedingFrenzy</li>
      <li MayRequire="redmattis.bigsmall.core">VU_Pounce</li>
      <li MayRequire="redmattis.bigsmall.core">BS_SnekEngulf</li>
      <li>RobustDigestion</li>
      <li>MoveSpeed_Quick</li>
      <li>Mood_Sanguine</li>
      <li MayRequire="redmattis.bigsmall.core">BS_Bloodlust</li>
      <li>KillThirst</li>
      <li>Sterile</li>
      <li MayRequire="redmattis.bigsmall.core">BS_AlienApperanceStandards_Lesser</li>
      <li MayRequire="redmattis.bigsmall.core">BS_CreepyHaired</li>
      <li>Hair_LongOnly</li>
      <li>Beard_NoBeardOnly</li>
      <li MayRequire="clownnosegene.mod">Nose_ClownBlue</li>
      <li MayRequire="clownnosegene.mod">Nose_ClownGreen</li>
      <li MayRequire="clownnosegene.mod">Nose_ClownOrange</li>
      <li MayRequire="clownnosegene.mod">Nose_ClownPink</li>
      <li MayRequire="clownnosegene.mod">Nose_ClownPurple</li>
      <li MayRequire="clownnosegene.mod">Nose_ClownRed</li>
