<?xml version="1.0" encoding="utf-8" ?>
<Defs

  <ScenarioDef ParentName="ScenarioBase">
    <defName>MSS_SFP_NewSafehaven</defName>
    <label>Hidden Village</label>
    <description>Your shinobi group has arrived at an hacking point. But with the valuable intel you carry, the Emperor's eye is on you. Aerodrones patrol the skies, and Imperial raiding parties are closing in. Use the intel to unlock powerful tech and deserter services, aiding your ultimate mission: to assassinate key Imperial nobility. Survive the initial onslaught and lay low; over time, the Empire's relentless search will wane. The choice is yours: fortify, adapt, or perish.\n\nNote: Since you start with high visibility, this is a difficult scenario.</description>
    <scenario>
      <summary>A new breakaway Cyber Clan, dedicated to defeating the Emperor.</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>VFED_NewSafehaven</factionDef>
      </playerFaction>
      <parts>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnChoiceCount>4</pawnChoiceCount>
          <pawnCount>3</pawnCount>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>MealSurvivalPack</thingDef>
          <count>40</count>
          <allowRoofed>True</allowRoofed>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>MedicineIndustrial</thingDef>
          <count>24</count>
          <allowRoofed>True</allowRoofed>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>MeleeWeapon_Millitary_Katana_AC</thingDef>
          <count>2</count>
          <allowRoofed>True</allowRoofed>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>10</count>
          <allowRoofed>True</allowRoofed>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>ComponentSpacer</thingDef>
          <count>10</count>
          <allowRoofed>True</allowRoofed>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>Silver</thingDef>
          <count>400</count>
          <allowRoofed>True</allowRoofed>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>VFED_Intel</thingDef>
          <count>40</count>
          <allowRoofed>True</allowRoofed>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsNearPlayerStart</def>
          <thingDef>VFED_CriticalIntel</thingDef>
          <count>6</count>
          <allowRoofed>True</allowRoofed>
        </li>
        <li Class="ScenPart_ScatterThingsAnywhere">
          <def>ScatterThingsAnywhere</def>
          <thingDef>Steel</thingDef>
          <count>400</count>
          <allowRoofed>True</allowRoofed>
        </li>
        <li Class="ScenPart_ScatterThingsAnywhere">
          <def>ScatterThingsAnywhere</def>
          <thingDef>WoodLog</thingDef>
          <count>600</count>
          <allowRoofed>True</allowRoofed>
        </li>
        <li Class="ScenPart_ScatterThingsAnywhere">
          <def>ScatterThingsAnywhere</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>30</count>
          <allowRoofed>True</allowRoofed>
        </li>
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>Your shinobi group has arrived at an hacking point. But with the valuable intel you carry, the Emperor's eye is on you. Aerodrones patrol the skies, and Imperial raiding parties are closing in. Use the intel to unlock powerful tech and deserter services, aiding your ultimate mission: to assassinate key Imperial nobility. Survive the initial onslaught and lay low; over time, the Empire's relentless search will wane. The choice is yours: fortify, adapt, or perish.\n\nNote: Since you start with high visibility, this is a difficult scenario.</text>
          <closeSound>GameStartSting</closeSound>
        </li>

        <li Class="KCSG.ScenPart_AddStartingStructure">
          <def>VFEC_AddStartingStructure</def>
          <structureLabel>An old bunker</structureLabel>
          <spawnTheStartingPawn>true</spawnTheStartingPawn>
          <nearMapCenter>True</nearMapCenter>
          <chooseFrom>
            <li>VFED_NewSafehaven1</li>
            <li>VFED_NewSafehaven2</li>
            <li>VFED_NewSafehaven3</li>
            <li>VFED_NewSafehaven4</li>
            <li>VFED_NewSafehaven5</li>
            <li>VFED_NewSafehaven6</li>
          </chooseFrom>
        </li>

        <li Class="VFED.ScenPart_StartDeserting">
          <def>VFED_StartDeserting</def>
          <startingVisibility>85</startingVisibility>
        </li>

        <li Class="ScenarioFactionTechLevel.ScenPart_SetTechLevel">
          <def>ScenarioFactionTechLevel</def>
          <techLevel>Industrial</techLevel>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>

</Defs>
